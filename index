<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Math Star Adventures - Grade 1 Mathematics</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome for playful icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Font: Fredoka -->
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Fredoka', 'sans-serif'],
          },
          animation: {
            'bounce-slow': 'bounce 2s infinite',
            'pulse-fast': 'pulse 1s infinite',
            'spin-slow': 'spin 8s linear infinite',
          }
        }
      }
    }
  </script>
  <style>
    .star-glow {
      text-shadow: 0 0 12px rgba(234, 179, 8, 0.8);
    }
    .card-pop {
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }
    .card-pop:hover {
      transform: translateY(-6px) scale(1.02);
      box-shadow: 0 14px 28px -4px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    .pop-btn {
      transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .pop-btn:active {
      transform: scale(0.92);
    }
    .confetti-particle {
      position: fixed;
      pointer-events: none;
      z-index: 999;
      animation: floatUp 1.2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }
    @keyframes floatUp {
      0% { opacity: 1; transform: translateY(0) scale(0.8) rotate(0deg); }
      50% { opacity: 1; transform: translateY(-80px) scale(1.3) rotate(180deg); }
      100% { opacity: 0; transform: translateY(-150px) scale(0.5) rotate(360deg); }
    }
  </style>
</head>
<body class="h-full bg-gradient-to-b from-sky-100 via-amber-50 to-emerald-100 text-slate-800 flex flex-col font-sans antialiased selection:bg-amber-300">

  <!-- Audio Toggle & Navigation Header -->
  <header class="bg-white/90 backdrop-blur-md border-b border-amber-200 sticky top-0 z-40 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer group" onclick="app.showDashboard()">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-400 to-orange-500 flex items-center justify-center text-white shadow-lg shadow-orange-200 group-hover:scale-110 transition transform">
          <i class="fa-solid fa-star text-2xl text-yellow-100 star-glow"></i>
        </div>
        <div>
          <span class="text-2xl font-extrabold bg-gradient-to-r from-amber-600 via-orange-500 to-pink-500 bg-clip-text text-transparent">Math Star</span>
          <p class="text-xs text-slate-500 font-semibold tracking-wide">Grade 1 Interactive</p>
        </div>
      </div>
      
      <div class="flex items-center space-x-3">
        <!-- Audio Toggle Button -->
        <button id="sound-btn" onclick="app.toggleSound()" class="px-3.5 py-2 rounded-2xl bg-slate-100 text-slate-700 font-bold hover:bg-slate-200 transition border border-slate-300 shadow-sm flex items-center space-x-2">
          <i id="sound-icon" class="fa-solid fa-volume-high text-amber-500"></i>
          <span class="text-xs hidden sm:inline">Sound</span>
        </button>

        <button onclick="app.showDashboard()" class="hidden sm:flex items-center space-x-2 px-4 py-2 rounded-2xl bg-sky-50 text-sky-700 font-bold hover:bg-sky-100 transition border border-sky-200 shadow-sm pop-btn">
          <i class="fa-solid fa-house-chimney"></i>
          <span>Home</span>
        </button>

        <div class="flex items-center space-x-2 bg-gradient-to-r from-amber-400 to-yellow-400 text-amber-950 px-4 py-2 rounded-2xl shadow-md border border-amber-300">
          <i class="fa-solid fa-star text-white star-glow text-lg"></i>
          <span id="global-stars" class="text-base font-extrabold">0 Stars</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Dynamic App View -->
  <main id="app-container" class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
  </main>

  <!-- Footer -->
  <footer class="bg-white/60 border-t border-amber-200/60 py-4 text-center text-xs text-slate-500 font-medium">
    Fun Interactive Grade 1 Math Practice • Star Adventures
  </footer>

  <!-- Celebration Modal -->
  <div id="reward-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-8 max-w-sm w-full mx-4 text-center shadow-2xl border-4 border-amber-300 transform scale-90 transition-transform duration-300" id="reward-modal-content">
      <div id="modal-icon-bg" class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4 text-amber-500 text-4xl animate-bounce">
        <i class="fa-solid fa-trophy"></i>
      </div>
      <h3 id="reward-title" class="text-2xl font-bold text-slate-800 mb-2">Awesome Job!</h3>
      <div id="reward-desc" class="text-slate-600 text-sm mb-6">You completed the activity!</div>
      <button onclick="app.closeRewardModal()" class="w-full py-3 bg-gradient-to-r from-emerald-400 to-teal-500 text-white font-bold rounded-2xl shadow-lg shadow-emerald-200 hover:from-emerald-500 hover:to-teal-600 transition text-lg pop-btn">
        Continue Playing!
      </button>
    </div>
  </div>

  <!-- Dynamic FX Layer -->
  <div id="fx-container" class="fixed inset-0 pointer-events-none z-50 overflow-hidden"></div>

  <script>
    // Audio Sound Effects (Web Audio API Synthesizer)
    class SoundFX {
      constructor() {
        this.enabled = true;
        this.ctx = null;
      }

      initCtx() {
        if (!this.ctx) {
          this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
      }

      playCorrect() {
        if (!this.enabled) return;
        this.initCtx();
        const now = this.ctx.currentTime;
        
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(523.25, now); // C5
        osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1); // E5
        osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2); // G5
        osc.frequency.exponentialRampToValueAtTime(1046.50, now + 0.3); // C6

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);

        osc.start(now);
        osc.stop(now + 0.5);
      }

      playIncorrect() {
        if (!this.enabled) return;
        this.initCtx();
        const now = this.ctx.currentTime;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(180, now);
        osc.frequency.linearRampToValueAtTime(120, now + 0.25);

        gain.gain.setValueAtTime(0.2, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);

        osc.start(now);
        osc.stop(now + 0.3);
      }

      playCelebration() {
        if (!this.enabled) return;
        this.initCtx();
        const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51];
        notes.forEach((freq, i) => {
          setTimeout(() => {
            const now = this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(0.25, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
            osc.start(now);
            osc.stop(now + 0.3);
          }, i * 90);
        });
      }
    }

    const soundFX = new SoundFX();

    // Game Question Data
    const mathTopics = [
      {
        id: 'counting',
        title: 'Counting & Numbers',
        subtitle: 'Count friendly items up to 10!',
        icon: 'fa-solid fa-calculator',
        color: 'from-sky-400 to-blue-500',
        badgeBg: 'bg-sky-100 text-sky-800 border-sky-300',
        cardBg: 'bg-sky-50',
        description: 'Count juicy apples, glowing stars, and cute animals to build your counting skills!',
        questions: [
          { type: 'count', target: 5, emoji: '🍎', prompt: 'How many juicy red apples do you see?' },
          { type: 'count', target: 8, emoji: '⭐', prompt: 'Count all the glowing stars!' },
          { type: 'count', target: 4, emoji: '🐱', prompt: 'How many playful kitties are here?' },
          { type: 'compare', q: 'Which number is BIGGER?', options: ['7', '4'], answer: 0 },
          { type: 'sequence', q: 'What number comes next? 1, 2, 3, ?', options: ['4', '5', '0'], answer: 0 }
        ]
      },
      {
        id: 'addition',
        title: 'Fun Addition',
        subtitle: 'Put numbers together!',
        icon: 'fa-solid fa-plus',
        color: 'from-emerald-400 to-teal-500',
        badgeBg: 'bg-emerald-100 text-emerald-800 border-emerald-300',
        cardBg: 'bg-emerald-50',
        description: 'Learn how to add objects together using visual helpers and simple equations.',
        questions: [
          { type: 'equation', a: 2, b: 3, emoji: '🎈', prompt: '2 + 3 = ?' },
          { type: 'equation', a: 4, b: 1, emoji: '🐣', prompt: '4 + 1 = ?' },
          { type: 'equation', a: 3, b: 3, emoji: '🌸', prompt: '3 + 3 = ?' },
          { type: 'equation', a: 5, b: 2, emoji: '🐶', prompt: '5 + 2 = ?' },
          { type: 'equation', a: 1, b: 6, emoji: '🍓', prompt: '1 + 6 = ?' }
        ]
      },
      {
        id: 'subtraction',
        title: 'Simple Subtraction',
        subtitle: 'Take away & find what is left!',
        icon: 'fa-solid fa-minus',
        color: 'from-pink-400 to-rose-500',
        badgeBg: 'bg-pink-100 text-pink-800 border-pink-300',
        cardBg: 'bg-pink-50',
        description: 'Practice taking items away and counting how many are remaining.',
        questions: [
          { type: 'sub_eq', a: 5, b: 2, emoji: '🍪', prompt: '5 - 2 = ?' },
          { type: 'sub_eq', a: 4, b: 1, emoji: '🚀', prompt: '4 - 1 = ?' },
          { type: 'sub_eq', a: 6, b: 3, emoji: '🎨', prompt: '6 - 3 = ?' },
          { type: 'sub_eq', a: 7, b: 4, emoji: '🐝', prompt: '7 - 4 = ?' },
          { type: 'sub_eq', a: 3, b: 0, emoji: '⚽', prompt: '3 - 0 = ?' }
        ]
      },
      {
        id: 'shapes',
        title: 'Shapes & Patterns',
        subtitle: 'Discover circles, squares & patterns!',
        icon: 'fa-solid fa-shapes',
        color: 'from-amber-400 to-orange-500',
        badgeBg: 'bg-amber-100 text-amber-800 border-amber-300',
        cardBg: 'bg-amber-50',
        description: 'Recognize colorful geometric shapes and complete fun visual patterns!',
        questions: [
          { type: 'shape', q: 'Which shape has 3 straight sides?', options: ['Triangle 🔺', 'Square 🟩', 'Circle 🔴'], answer: 0 },
          { type: 'shape', q: 'What shape looks like a round wheel or ball?', options: ['Rectangle 🟦', 'Circle 🔴', 'Square 🟩'], answer: 1 },
          { type: 'shape', q: 'Complete the pattern: 🔴 🟦 🔴 🟦 ?', options: ['🔴', '🟦', '⭐'], answer: 0 },
          { type: 'shape', q: 'How many corners does a square have?', options: ['3', '4', '5'], answer: 1 },
          { type: 'shape', q: 'Which shape has 4 equal straight sides?', options: ['Triangle 🔺', 'Square 🟩', 'Star ⭐'], answer: 1 }
        ]
      }
    ];

    class MathApp {
      constructor() {
        this.loadState();
        this.currentView = 'dashboard';
        this.activeTopicId = null;
        this.currentQuestionIndex = 0;
        this.score = 0;
        this.init();
      }

      loadState() {
        const saved = localStorage.getItem('math_star_progress_v2');
        if (saved) {
          try {
            this.progress = JSON.parse(saved);
          } catch(e) {
            this.progress = {};
          }
        } else {
          this.progress = {};
        }
      }

      saveState() {
        localStorage.setItem('math_star_progress_v2', JSON.stringify(this.progress));
        this.updateTotalStarsDisplay();
      }

      getTotalStars() {
        let total = 0;
        for (let topicId in this.progress) {
          total += (this.progress[topicId]?.stars || 0);
        }
        return total;
      }

      updateTotalStarsDisplay() {
        const el = document.getElementById('global-stars');
        if (el) {
          el.innerText = `${this.getTotalStars()} Stars`;
        }
      }

      toggleSound() {
        soundFX.enabled = !soundFX.enabled;
        const icon = document.getElementById('sound-icon');
        if (soundFX.enabled) {
          icon.className = 'fa-solid fa-volume-high text-amber-500';
        } else {
          icon.className = 'fa-solid fa-volume-xmark text-slate-400';
        }
      }

      init() {
        this.updateTotalStarsDisplay();
        this.render();
      }

      showDashboard() {
        this.currentView = 'dashboard';
        this.activeTopicId = null;
        this.render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      startTopic(topicId) {
        this.currentView = 'game';
        this.activeTopicId = topicId;
        this.currentQuestionIndex = 0;
        this.score = 0;
        this.render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      answerQuestion(selectedIndex, correctIndex, event) {
        const topic = mathTopics.find(t => t.id === this.activeTopicId);
        const feedbackEl = document.getElementById('question-feedback');
        
        // Disable buttons to avoid multiple rapid clicks
        const buttons = document.querySelectorAll('.option-btn');
        buttons.forEach(b => b.disabled = true);

        if (selectedIndex === correctIndex) {
          this.score += 2;
          soundFX.playCorrect();
          
          feedbackEl.innerHTML = `
            <div class="bg-emerald-100 border-2 border-emerald-300 text-emerald-800 p-4 rounded-2xl flex items-center justify-center space-x-3 animate-bounce">
              <span class="text-3xl">🎉</span>
              <span class="font-extrabold text-lg">Correct! Great Job! (+2 Stars)</span>
            </div>
          `;
          
          if (event) {
            this.triggerBurst(event.clientX, event.clientY);
          } else {
            this.triggerBurst(window.innerWidth / 2, window.innerHeight / 2);
          }

        } else {
          soundFX.playIncorrect();
          feedbackEl.innerHTML = `
            <div class="bg-rose-100 border-2 border-rose-300 text-rose-800 p-4 rounded-2xl flex items-center justify-center space-x-3">
              <span class="text-3xl">💪</span>
              <span class="font-extrabold text-lg">Good try! Keep going!</span>
            </div>
          `;
        }

        setTimeout(() => {
          this.currentQuestionIndex++;
          if (this.currentQuestionIndex < topic.questions.length) {
            this.renderGameView();
          } else {
            this.finishTopicGame();
          }
        }, 1400);
      }

      finishTopicGame() {
        soundFX.playCelebration();
        const topicId = this.activeTopicId;
        if (!this.progress[topicId]) {
          this.progress[topicId] = { stars: 0, completed: false };
        }
        const earnedStars = this.score;
        this.progress[topicId].stars = Math.max(this.progress[topicId].stars, earnedStars);
        this.progress[topicId].completed = true;
        this.saveState();

        const modal = document.getElementById('reward-modal');
        const title = document.getElementById('reward-title');
        const desc = document.getElementById('reward-desc');
        
        title.innerText = `Topic Completed! 🎉`;
        desc.innerHTML = `
          <p class="text-slate-600 text-base font-semibold mb-2">Fantastic Work!</p>
          <div class="inline-flex items-center space-x-2 bg-amber-100 text-amber-900 border border-amber-300 px-4 py-2 rounded-2xl font-extrabold text-lg">
            <i class="fa-solid fa-star text-yellow-500 star-glow"></i>
            <span>You Earned ${earnedStars} Stars!</span>
          </div>
        `;
        
        modal.classList.remove('hidden');
        setTimeout(() => modal.classList.remove('opacity-0'), 10);
      }

      closeRewardModal() {
        const modal = document.getElementById('reward-modal');
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          this.showDashboard();
        }, 300);
      }

      triggerBurst(x, y) {
        const container = document.getElementById('fx-container');
        const emojis = ['⭐', '🌟', '✨', '🎉', '🎈'];
        
        for (let i = 0; i < 12; i++) {
          const particle = document.createElement('div');
          particle.className = 'confetti-particle text-2xl';
          particle.innerText = emojis[Math.floor(Math.random() * emojis.length)];
          particle.style.left = `${x + (Math.random() * 120 - 60)}px`;
          particle.style.top = `${y + (Math.random() * 60 - 30)}px`;
          container.appendChild(particle);

          setTimeout(() => particle.remove(), 1200);
        }
      }

      render() {
        const container = document.getElementById('app-container');
        if (this.currentView === 'dashboard') {
          container.innerHTML = this.getDashboardHTML();
        } else if (this.currentView === 'game') {
          container.innerHTML = this.getGameHTML();
        }
      }

      renderGameView() {
        const wrapper = document.getElementById('game-dynamic-wrapper');
        if (wrapper) {
          wrapper.innerHTML = this.getGameInnerHTML();
        }
      }

      getDashboardHTML() {
        const totalStars = this.getTotalStars();
        return `
          <!-- Hero Banner -->
          <div class="mb-10 text-center sm:text-left flex flex-col sm:flex-row sm:items-center sm:justify-between bg-gradient-to-r from-amber-400 via-orange-400 to-pink-500 text-white p-8 sm:p-10 rounded-3xl shadow-xl relative overflow-hidden">
            <div class="absolute -right-6 -bottom-6 text-white/10 text-9xl pointer-events-none">
              <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="max-w-2xl mb-6 sm:mb-0 z-10">
              <span class="bg-white/20 backdrop-blur-md px-4 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider mb-3 inline-block border border-white/20">
                Grade 1 Mathematics
              </span>
              <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">Welcome to Math Star Adventures! ⭐</h1>
              <p class="text-amber-50 text-base leading-relaxed">Pick a topic below, play fun mini-games, and collect shiny star rewards!</p>
            </div>
            <div class="z-10 bg-white/20 backdrop-blur-md p-5 rounded-2xl border border-white/20 text-center min-w-[160px]">
              <span class="text-xs uppercase font-extrabold text-amber-100 block mb-1">Total Stars</span>
              <div class="flex items-center justify-center space-x-2">
                <i class="fa-solid fa-star text-yellow-200 text-2xl star-glow"></i>
                <span class="text-3xl font-extrabold">${totalStars}</span>
              </div>
            </div>
          </div>

          <!-- Topics Grid -->
          <h2 class="text-2xl font-extrabold text-slate-800 mb-6 flex items-center">
            <i class="fa-solid fa-map-location-dot mr-3 text-amber-500"></i> Choose Your Math Adventure
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            ${mathTopics.map(topic => {
              const topicProgress = this.progress[topic.id] || { stars: 0, completed: false };
              return `
                <div onclick="app.startTopic('${topic.id}')" class="bg-white rounded-3xl border-2 border-slate-100 shadow-sm card-pop p-6 flex flex-col justify-between cursor-pointer group relative overflow-hidden">
                  <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br ${topic.color} opacity-10 rounded-bl-full pointer-events-none group-hover:scale-110 transition"></div>
                  <div>
                    <div class="flex items-center justify-between mb-4">
                      <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr ${topic.color} flex items-center justify-center text-white text-2xl shadow-md">
                        <i class="${topic.icon}"></i>
                      </div>
                      <span class="px-3 py-1.5 rounded-full text-xs font-bold border ${topic.badgeBg}">
                        ${topicProgress.completed ? '✓ Completed' : 'Ready to Play'}
                      </span>
                    </div>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">${topic.subtitle}</span>
                    <h3 class="text-2xl font-extrabold text-slate-800 mt-1 mb-2 group-hover:text-orange-500 transition">${topic.title}</h3>
                    <p class="text-slate-600 text-sm mb-6">${topic.description}</p>
                  </div>
                  
                  <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                    <div class="flex items-center space-x-1.5 text-amber-500 font-bold text-sm">
                      <i class="fa-solid fa-star text-amber-400 star-glow"></i>
                      <span>${topicProgress.stars} Stars Earned</span>
                    </div>
                    <div class="px-5 py-2.5 rounded-2xl bg-amber-400 text-amber-950 font-extrabold text-sm shadow-sm group-hover:bg-amber-500 transition flex items-center space-x-2 pop-btn">
                      <span>Play Now</span>
                      <i class="fa-solid fa-arrow-right text-xs"></i>
                    </div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }

      getGameHTML() {
        return `
          <div id="game-dynamic-wrapper">
            ${this.getGameInnerHTML()}
          </div>
        `;
      }

      getGameInnerHTML() {
        const topic = mathTopics.find(t => t.id === this.activeTopicId);
        if (!topic) return '<div>Topic not found</div>';

        const q = topic.questions[this.currentQuestionIndex];
        const totalQ = topic.questions.length;
        const progressPercent = Math.round((this.currentQuestionIndex / totalQ) * 100);

        let questionVisualHTML = '';
        let optionsHTML = '';

        if (q.type === 'count') {
          let itemsStr = '';
          for (let i = 0; i < q.target; i++) {
            itemsStr += `<span class="text-4xl sm:text-5xl hover:scale-125 transition transform cursor-pointer select-none inline-block p-1" onclick="app.triggerBurst(event.clientX, event.clientY)">${q.emoji}</span>`;
          }
          questionVisualHTML = `
            <div class="text-2xl font-extrabold text-slate-800 mb-2">${q.prompt}</div>
            <p class="text-xs font-bold text-slate-400 mb-4">Tap items to count them!</p>
            <div class="bg-amber-50/80 border-2 border-dashed border-amber-300 rounded-3xl p-6 mb-6 flex flex-wrap items-center justify-center gap-3 min-h-[130px]">
              ${itemsStr}
            </div>
          `;

          let opts = [q.target, q.target + 1 > 12 ? 12 : q.target + 1, q.target - 1 < 1 ? 3 : q.target - 1];
          opts = [...new Set(opts)].sort(() => Math.random() - 0.5);
          const correctIdx = opts.indexOf(q.target);

          optionsHTML = `
            <div class="grid grid-cols-3 gap-4">
              ${opts.map((opt, idx) => `
                <button onclick="app.answerQuestion(${idx},${correctIdx}, event)" class="option-btn py-4 bg-white border-2 border-slate-200 hover:border-amber-400 text-slate-800 font-extrabold text-3xl rounded-2xl shadow-sm hover:shadow-md pop-btn transition">
                  ${opt}
                </button>
              `).join('')}
            </div>
          `;
        } 
        else if (q.type === 'equation') {
          const answerVal = q.a + q.b;
          let aItems = Array(q.a).fill(q.emoji).map(e => `<span class="text-3xl">${e}</span>`).join(' ');
          let bItems = Array(q.b).fill(q.emoji).map(e => `<span class="text-3xl">${e}</span>`).join(' ');

          questionVisualHTML = `
            <div class="text-3xl font-extrabold text-slate-800 mb-4">${q.prompt}</div>
            <div class="flex items-center justify-center space-x-3 bg-emerald-50/80 border-2 border-dashed border-emerald-200 rounded-3xl p-4 mb-6">
              <div class="bg-white px-3 py-2 rounded-xl shadow-sm border border-emerald-100 flex gap-1">${aItems}</div>
              <span class="text-2xl font-extrabold text-emerald-600">+</span>
              <div class="bg-white px-3 py-2 rounded-xl shadow-sm border border-emerald-100 flex gap-1">${bItems}</div>
            </div>
          `;

          let opts = [answerVal, answerVal + 1, answerVal - 1 < 1 ? 2 : answerVal - 1];
          opts = [...new Set(opts)].sort(() => Math.random() - 0.5);
          const correctIdx = opts.indexOf(answerVal);

          optionsHTML = `
            <div class="grid grid-cols-3 gap-4">
              ${opts.map((opt, idx) => `
                <button onclick="app.answerQuestion(${idx},${correctIdx}, event)" class="option-btn py-4 bg-white border-2 border-slate-200 hover:border-emerald-400 text-slate-800 font-extrabold text-3xl rounded-2xl shadow-sm hover:shadow-md pop-btn transition">
                  ${opt}
                </button>
              `).join('')}
            </div>
          `;
        }
        else if (q.type === 'sub_eq') {
          const answerVal = q.a - q.b;
          let items = '';
          for (let i = 0; i < q.a; i++) {
            if (i >= q.a - q.b) {
              items += `<span class="text-3xl opacity-30 line-through">${q.emoji}</span> `;
            } else {
              items += `<span class="text-3xl">${q.emoji}</span> `;
            }
          }

          questionVisualHTML = `
            <div class="text-3xl font-extrabold text-slate-800 mb-4">${q.prompt}</div>
            <div class="bg-rose-50/80 border-2 border-dashed border-rose-200 rounded-3xl p-4 mb-6 flex justify-center items-center gap-2">
              ${items}
            </div>
          `;

          let opts = [answerVal, answerVal + 1, answerVal - 1 < 0 ? 3 : answerVal - 1];
          opts = [...new Set(opts)].sort(() => Math.random() - 0.5);
          const correctIdx = opts.indexOf(answerVal);

          optionsHTML = `
            <div class="grid grid-cols-3 gap-4">
              ${opts.map((opt, idx) => `
                <button onclick="app.answerQuestion(${idx},${correctIdx}, event)" class="option-btn py-4 bg-white border-2 border-slate-200 hover:border-rose-400 text-slate-800 font-extrabold text-3xl rounded-2xl shadow-sm hover:shadow-md pop-btn transition">
                  ${opt}
                </button>
              `).join('')}
            </div>
          `;
        }
        else {
          questionVisualHTML = `
            <div class="text-2xl font-extrabold text-slate-800 mb-6 text-center">${q.q}</div>
          `;

          optionsHTML = `
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              ${q.options.map((opt, idx) => `
                <button onclick="app.answerQuestion(${idx},${q.answer}, event)" class="option-btn py-4 px-6 bg-white border-2 border-slate-200 hover:border-amber-400 text-slate-800 font-extrabold text-xl rounded-2xl shadow-sm hover:shadow-md pop-btn transition text-center">
                  ${opt}
                </button>
              `).join('')}
            </div>
          `;
        }

        return `
          <div class="mb-6 flex items-center justify-between">
            <button onclick="app.showDashboard()" class="inline-flex items-center text-sm font-bold text-slate-600 hover:text-amber-600 transition bg-white border border-slate-200 px-4 py-2 rounded-2xl shadow-sm pop-btn">
              <i class="fa-solid fa-arrow-left mr-2"></i> Exit Activity
            </button>
            <div class="flex items-center space-x-3">
              <span class="text-xs font-extrabold px-3 py-1.5 rounded-full border ${topic.badgeBg}">${topic.title}</span>
              <span class="text-xs font-extrabold px-3 py-1.5 rounded-full bg-amber-100 text-amber-900 border border-amber-200">Question ${this.currentQuestionIndex + 1} of ${totalQ}</span>
            </div>
          </div>

          <!-- Progress Bar -->
          <div class="w-full bg-white/80 border border-slate-200 h-4 rounded-full overflow-hidden p-0.5 mb-8 shadow-inner">
            <div class="bg-gradient-to-r from-amber-400 to-orange-500 h-full rounded-full transition-all duration-500" style="width: ${progressPercent}%"></div>
          </div>

          <!-- Game Question Card -->
          <div class="bg-white rounded-3xl border-2 border-slate-100 shadow-lg p-6 sm:p-10 max-w-2xl mx-auto text-center relative overflow-hidden">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr ${topic.color} flex items-center justify-center text-white text-3xl mx-auto mb-6 shadow-md">
              <i class="${topic.icon}"></i>
            </div>
            
            ${questionVisualHTML}

            <div id="question-feedback" class="mb-6"></div>

            ${optionsHTML}
          </div>
        `;
      }
    }

    // Initialize application instance
    const app = new MathApp();
  </script>
</body>
</html>
